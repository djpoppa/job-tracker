# IDEs
# -----------------------------

# VS Code
.vscode/*
!.vscode/extensions.json

# IntelliJ IDEA
.idea
*.iws
*.iml
*.ipr

# Eclipse / Spring Tools Suite
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# Visual Studio
*.suo
*.ntvs*
*.njsproj
*.sln

